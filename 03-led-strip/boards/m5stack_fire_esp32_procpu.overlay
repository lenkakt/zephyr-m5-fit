/*
 * The M5Stack Fire has an onboard SK6812 (WS2812-compatible) RGB LED strip
 * of 10 pixels, wired to GPIO15 as a single data line. Zephyr's GPIO
 * bit-bang WS2812 driver only supports Nordic nRF SoCs, so on ESP32 we
 * drive it over SPI instead: SPI2 is otherwise unused on this board (SPI3
 * is already claimed by the SD card), and its MOSI signal is routed to
 * GPIO15 via the ESP32 GPIO matrix (SCLK/MISO are left unconnected -
 * WS2812 only needs the data line).
 */

#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <zephyr/dt-bindings/pinctrl/esp32-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32-gpio-sigmap.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/led/worldsemi_ws2812c.h>

/ {
	aliases {
		led-strip = &led_strip;
	};
};

&pinctrl {
	spim2_ws2812_led: spim2_ws2812_led {
		group1 {
			pinmux = <SPIM2_MOSI_GPIO15>;
		};
	};
};

&spi2 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim2_ws2812_led>;
	pinctrl-names = "default";
	line-idle-low;

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <WS2812C_SPI_FREQ>;

		chain-length = <10>;
		color-mapping = <LED_COLOR_ID_GREEN>,
				 <LED_COLOR_ID_RED>,
				 <LED_COLOR_ID_BLUE>;
		spi-one-frame = <WS2812C_ONE_FRAME>;
		spi-zero-frame = <WS2812C_ZERO_FRAME>;
	};
};
